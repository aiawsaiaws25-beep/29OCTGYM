# Neon connection string. Leave empty to use the local embedded database (.pglite) while developing.
DATABASE_URL=
# Secret for signing login cookies. Leave empty and `npm run dev` generates one for you.
JWT_SECRET=
# Optional: port for the local API server (default 3001)
API_PORT=

